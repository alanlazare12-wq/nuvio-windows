{
  "name": "nuviodrive-v1",
  "private": true,
  "version": "1.2.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "tsc --noEmit",
    "qa:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "qa:perf": "cargo test --release --manifest-path src-tauri/Cargo.toml --lib catalog_performance_budget_250k -- --ignored --nocapture",
    "qa:ui": "node scripts/qa-ui.mjs",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "windows:setup": "node scripts/package-windows.mjs",
    "android:init": "node scripts/tauri-android.mjs init",
    "android:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-android.ps1",
    "android:dev": "node scripts/tauri-android.mjs dev",
    "android:build": "node scripts/tauri-android.mjs build --debug --apk --target aarch64",
    "android:release": "node scripts/tauri-android.mjs build --apk --target aarch64",
    "qa:auth": "node scripts/qa-auth.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^1.46.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "playwright": "^1.63.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0"
  },
  "packageManager": "pnpm@11.19.0"
}
